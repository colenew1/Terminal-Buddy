{
  "name": "terminal-buddy",
  "version": "0.1.10",
  "description": "Friendly, organized terminals for your coding agents, with custom names and desktop alerts.",
  "main": "./out/main/index.js",
  "author": "Terminal Buddy contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-branding.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "npm run icon && electron-vite build && electron-builder --win nsis portable",
    "dist:mac": "npm run icon && electron-vite build && electron-builder --mac",
    "dist:win": "npm run dist",
    "test:platform": "node scripts/verify-platform.mjs",
    "test:platform-app": "node scripts/verify-platform-app.mjs",
    "test:assistants": "node scripts/verify-assistants.mjs",
    "test:launcher": "node scripts/verify-launcher.mjs",
    "test:windows": "node scripts/verify-windows.mjs",
    "postinstall": "electron-builder install-app-deps && node scripts/dev-branding.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "npm run typecheck && npm run test:platform && npm run test:catalog && npm run test:settings && npm run test:alerts && npm run test:submit && npm run test:screen && npm run build && npm run test:windows && npm run test:launcher && npm run test:assistants && npm run test:features && npm run test:popout && npm run test:restore && npm run test:smoke && npm run test:feed && npm run test:grid && npm run test:resize && npm run test:import && npm run test:registry",
    "test:settings": "node scripts/verify-settings-store.mjs",
    "test:features": "node scripts/verify-features.mjs",
    "test:popout": "node scripts/verify-popout.mjs",
    "test:screen": "node scripts/verify-terminal-screen.mjs",
    "test:restore": "node scripts/verify-restore.mjs",
    "test:resize": "node scripts/verify-resize.mjs",
    "test:submit": "node scripts/verify-submit.mjs",
    "test:alerts": "node scripts/verify-alerts.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:grid": "node scripts/verify-grid.mjs",
    "test:import": "node scripts/verify-import.mjs",
    "test:catalog": "node scripts/verify-catalog.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test:feed": "node scripts/verify-feed.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "keywords": [
    "terminal",
    "electron",
    "xterm",
    "claude-code",
    "codex",
    "windows",
    "terminal-manager"
  ]
}
