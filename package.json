{
  "name": "terminal-buddy",
  "version": "0.1.0",
  "description": "A calm home for your coding agents. Conversations, not terminals \u2014 with the terminal still there when you want it.",
  "main": "./out/main/index.js",
  "author": "Terminal Buddy contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "postinstall": "electron-builder install-app-deps",
    "icon": "python scripts/make-icon.py",
    "test": "npm run typecheck && npm run build && npm run test:smoke && npm run test:feed && npm run test:grid && npm run test:registry",
    "test:smoke": "node scripts/smoke.mjs",
    "test:grid": "node scripts/verify-grid.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test:feed": "node scripts/verify-feed.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "keywords": [
    "terminal",
    "electron",
    "xterm",
    "claude-code",
    "codex",
    "windows",
    "terminal-manager"
  ]
}
